# Copy to .env.local (gitignored) and fill in. See plan §1.

# --- Turso (LibSQL) — dev DB (use a separate DB for prod) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=
# Base URL of the app (used for building invite/verify/reset links)
AUTH_URL=http://localhost:3000

# --- Receipt OCR ---
# OCR uses tesseract.js (open-source, runs offline) — NO API key required.
# (The spec originally proposed Claude vision; replaced per request with an
#  on-device OSS engine. tesseract.js downloads its language model once and caches it.)

# --- Photo storage: local (dev) | r2 (prod) ---
STORAGE_ADAPTER=local
# R2 (only needed when STORAGE_ADAPTER=r2, T19)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Email: mailpit (dev) | resend (prod) ---
EMAIL_ADAPTER=mailpit
EMAIL_FROM=noreply@petal.local
# Mailpit SMTP (dev) — default localhost:1025
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
# Resend (only needed when EMAIL_ADAPTER=resend, T20)
RESEND_API_KEY=
