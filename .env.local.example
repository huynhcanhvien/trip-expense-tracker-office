# Copy to .env.local (gitignored) and fill in.

# --- Turso (LibSQL) — dev DB (use a separate DB for prod) ---
# Leave empty to use the local file fallback (file:local.db) for offline dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Base URL of the app (used for building shareable trip links)
APP_URL=http://localhost:3000

# --- Receipt OCR ---
# OCR uses a local vision LLM (qwen2.5vl:3b) served by Ollama — NO API key,
# images never leave the host. Requires Ollama running with the model pulled:
#   brew install ollama && ollama serve
#   ollama pull qwen2.5vl:3b
# Override the server/model if needed (defaults shown):
# OLLAMA_URL=http://localhost:11434
# OCR_MODEL=qwen2.5vl:3b

# --- Photo storage: local (dev) | r2 (prod) ---
STORAGE_ADAPTER=local
# R2 (only needed when STORAGE_ADAPTER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
