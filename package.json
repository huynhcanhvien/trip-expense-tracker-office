{
  "name": "trip-expense-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "migrate": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/app src/i18n src/lib/supabase src/lib/office-*.ts src/proxy.ts messages tests/i18n.test.ts tests/server-messages.test.ts tests/e2e-office scripts/audit-ui.mjs scripts/browser.mjs playwright.config.ts next.config.ts",
    "e2e:prepare": "node scripts/prepare-e2e.mjs",
    "deploy:check": "node scripts/check-production-env.mjs",
    "ui:audit": "node scripts/audit-ui.mjs",
    "ui:audit:simulate": "node scripts/audit-ui.mjs --simulate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.52.0",
    "next": "16.2.9",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "description": "Office group expenses \u2014 Supabase Auth, PostgreSQL, private images and Groq OCR"
}
